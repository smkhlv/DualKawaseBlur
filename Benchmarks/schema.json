{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smkhlv/DualKawaseBlur/Benchmarks/schema.json",
  "title": "DualKawaseBlur benchmark export",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/record" } }
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": ["version", "createdAt", "device", "workload", "timings", "counts", "memory"],
      "properties": {
        "version": { "const": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "device": {
          "type": "object",
          "required": ["model", "gpuName", "gpuFamilies", "osVersion", "osBuild", "environment", "thermalState", "minimumRefreshRate", "maximumRefreshRate"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "gpuName": { "type": "string", "minLength": 1 },
            "gpuFamilies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "osVersion": { "type": "string", "minLength": 1 },
            "osBuild": { "type": "string", "minLength": 1 },
            "environment": { "enum": ["device", "simulator"] },
            "thermalState": { "type": "string", "minLength": 1 },
            "minimumRefreshRate": { "type": "number", "minimum": 0 },
            "maximumRefreshRate": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "workload": { "type": "object", "required": ["width", "height", "pixelFormat", "algorithm", "matchedSecondMoment", "normalizedRMSE", "warmUpIterations", "measuredIterations"] },
        "timings": { "type": "object", "required": ["cpuEncodeMilliseconds", "gpuMilliseconds", "endToEndMilliseconds", "cpuP50", "cpuP95", "cpuP99", "gpuP50", "gpuP95", "gpuP99"] },
        "counts": { "type": "object", "required": ["encoded", "completed", "droppedNoCapacity", "droppedEncodingFailure", "droppedDeadline"] },
        "memory": { "type": "object", "required": ["residentBytesBefore", "residentBytesAfter", "peakResidentBytes", "allocationCount"] }
      },
      "additionalProperties": false
    }
  }
}
